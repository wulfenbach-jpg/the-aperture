      "initial": {
        "seed": 201,
        "active": "P0",
        "step": "PrecombatMain",
        "priority": "P0",
        "zones": {
          "P0": {"battlefield": ["Grizzly Bears"]}
        },
        "permanents": {
          "Grizzly Bears": {"damage": 2}
        }
      },
      "steps": [
        {
          "player": "P0",
          "action": {"type": "pass"},
          "events": [
            {"type": "Pass", "player": "P0"},
            {"type": "Priority", "player": "P1"}
          ],
          "expect_pending": "none",
          "expect_priority": "P1",
          "expect_step": "PrecombatMain"
        }
      ],
      "expect": {
        "life": {"P0": 20, "P1": 20},
        "turn": 1,
        "step": "PrecombatMain",
        "priority": "P1",
        "pending": "none",
        "zones": {
          "P0": {"battlefield": [], "graveyard": ["Grizzly Bears"]}
        }
      }
    },
    {
      "id": "sba.zero_toughness_sends_the_creature_to_the_graveyard",
