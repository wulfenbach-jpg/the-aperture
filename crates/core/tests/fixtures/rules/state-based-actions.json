      "initial": {
        "seed": 202,
        "active": "P0",
        "step": "PrecombatMain",
        "priority": "P0",
        "zones": {
          "P0": {"battlefield": ["Grizzly Bears"]}
        },
        "permanents": {
          "Grizzly Bears": {"pump_toughness": -2}
        }
      },
      "steps": [
        {
          "player": "P0",
          "action": {"type": "pass"},
          "events": [{"type": "Pass", "player": "P0"}],
          "expect_pending": "none",
          "expect_priority": "P1"
        }
      ],
      "expect": {
        "life": {"P0": 20, "P1": 20},
        "pending": "none",
        "zones": {
