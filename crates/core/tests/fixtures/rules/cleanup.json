    {
      "id": "cleanup.discard_down_to_maximum_hand_size",
      "description": "At the beginning of the cleanup step the active player discards down to seven cards.",
      "rule_refs": ["CR 514.1", "CR 402.2"],
      "initial": {
        "seed": 301,
        "active": "P0",
        "step": "EndStep",
        "priority": "P0",
        "zones": {
          "P0": {
            "hand": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Shock", "Shock"]
          }
        }
      },
      "steps": [
        {
          "player": "P0",
          "action": {"type": "pass"},
          "events": [{"type": "Pass", "player": "P0"}],
          "expect_pending": "none",
          "expect_priority": "P1"
        },
        {
          "player": "P1",
          "action": {"type": "pass"},
          "events": [
            {"type": "Pass", "player": "P1"},
            {"type": "StepBegin", "step": "Cleanup"}
          ],
          "expect_pending": "Discard(2)",
          "expect_priority": "none",
          "expect_step": "Cleanup"
        },
        {
          "player": "P0",
          "action": {"type": "discard", "cards": ["Shock", "Shock"]},
          "events": [
            {"type": "Discarded", "player": "P0", "card": "Shock"},
            {"type": "Discarded", "player": "P0", "card": "Shock"}
          ],
          "expect_pending": "none",
          "expect_priority": "P1",
          "expect_step": "Upkeep",
          "expect_turn": 2
        }
      ],
      "expect": {
        "life": {"P0": 20, "P1": 20},
        "turn": 2,
        "step": "Upkeep",
        "priority": "P1",
        "pending": "none",
        "zones": {
          "P0": {
            "hand": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"],
            "graveyard": ["Shock", "Shock"],
            "battlefield": []
          }
        }
      }
    },
    {
